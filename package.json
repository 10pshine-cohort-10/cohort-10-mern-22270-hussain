{
  "name": "folio-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "npm run test:backend && npm run test:frontend",
    "db:migrate": "node server/migrate.js",
    "test:backend": "c8 --reports-dir=coverage/backend --reporter=text --reporter=lcov mocha test/backend.test.js",
    "test:frontend": "jest --runInBand",
    "test:integration": "mocha test/mysql.integration.js",
    "test:live": "node test/live.smoke.js",
    "format": "prettier --write client server test *.js *.cjs *.json README.md QUALITY.md"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "mysql2": "^3.14.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.0",
    "@babel/preset-react": "^7.27.0",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-jest": "^29.7.0",
    "c8": "^10.1.0",
    "chai": "^5.2.0",
    "concurrently": "^9.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mocha": "^11.5.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "vite": "^6.3.0"
  }
}
